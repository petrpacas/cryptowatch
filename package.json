{
  "name": "cryptowatch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "mcp:check": "node scripts/check-supabase-mcp.mjs",
    "milestone3:check": "node scripts/check-milestone-three.mjs",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local --level warning",
    "functions:check": "docker run --rm -v \"$PWD:/workspace\" -w /workspace denoland/deno:2.1.4 deno check supabase/functions/sync-coins/index.ts",
    "functions:test": "docker run --rm -v \"$PWD:/workspace\" -w /workspace denoland/deno:2.1.4 deno test supabase/functions/sync-coins/catalog.test.ts",
    "functions:serve": "supabase functions serve sync-coins --no-verify-jwt",
    "supabase:start": "supabase start",
    "supabase:status": "supabase status",
    "supabase:stop": "supabase stop"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "supabase": "^2.117.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0"
  }
}
