# Custom secrets used by Edge Functions. Never commit the real `.env` file.
# Supabase injects SUPABASE_URL and its API keys automatically.
COINGECKO_DEMO_API_KEY=replace-with-coingecko-demo-key
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM=CryptoWatch <alerts@mail.example.com>
WORKER_SECRET=replace-with-a-long-random-value
