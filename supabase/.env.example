# Local/remote Edge Function secrets. Never commit the file without `.example`.
COINGECKO_DEMO_API_KEY=replace-with-coingecko-demo-key
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM=CryptoWatch <alerts@mail.example.com>
WORKER_SECRET=replace-with-a-long-random-value

# Used by local Supabase Auth once Google login is configured in milestone 3.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=replace-with-google-client-secret
